# ==============================================================================
# Painel de Impressoras BI - Modelo de Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais do ambiente.
# ==============================================================================

# String de conexão PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/painel_impressoras_bi?schema=public"

# Chave exclusiva de autenticação dos agentes de coleta (Header x-api-key)
# Gere uma chave aleatória forte (32+ caracteres)
INGESTAO_API_KEY="substitua_por_chave_exclusiva_dos_agentes_32_chars"

# Segredo exclusivo para assinatura de sessões administrativas JWT (HS256)
# NUNCA reutilize INGESTAO_API_KEY aqui!
ADMIN_JWT_SECRET="substitua_por_segredo_jwt_exclusivo_com_32_ou_mais_caracteres"

# Senha de acesso administrativo ao Painel BI
PAINEL_ADMIN_PASSWORD="substitua_por_senha_forte_admin"

# URL base pública/interna do painel e portas HTTP/HTTPS
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PORT=3000
PORT_HTTPS=3443

# (Opcional) URL local permitida para o provedor Ollama offline
OLLAMA_BASE_URL="http://127.0.0.1:11434"

